page {
  background: #f4f7f5;
}

.doc {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.doc-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  text-align: center;
}

.doc-date {
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
  margin: 12rpx 0 32rpx;
}

.section {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 10rpx;
}

.section-text {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.8;
}

/* 深色模式 */
@media (prefers-color-scheme: dark) {
  page {
    background: #111827;
  }

  .doc {
    background: #1f2937;
    box-shadow: none;
  }

  .doc-title,
  .section-title {
    color: #e5e7eb;
  }

  .section-text {
    color: #d1d5db;
  }
}
