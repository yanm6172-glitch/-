<view class="page">

  <view class="card">
    <view class="card-head">
      <text class="card-title">📸 饮食日记</text>
      <text class="card-num">{{groups.length}} 天有记录</text>
    </view>
    <view class="tip">在「热量」页用拍食物记录的照片会自动出现在这里，形成你的饮食时间轴。</view>
  </view>

  <block wx:if="{{groups.length > 0}}">
    <view class="card" wx:for="{{groups}}" wx:key="key" wx:for-item="g">
      <view class="date-head">
        <text class="date-label">📅 {{g.label}}</text>
        <text class="date-sub">{{g.foods.length}} 张照片</text>
      </view>
      <view class="d-item" wx:for="{{g.foods}}" wx:key="index" wx:for-item="f">
        <image class="d-img" src="{{f.image}}" mode="aspectFill" />
        <view class="d-main">
          <view class="d-name">{{f.name}}</view>
          <view class="d-sub">{{f.grams}}g · {{f.kcal}} 千卡{{f.time ? ' · ' + f.time : ''}}</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="card">
    <view class="empty">还没有照片记录。去「热量」页点「📸 拍食物」，识别后计入的照片会自动生成日记。</view>
    <view class="row">
      <button size="mini" bindtap="goCalorie">去拍食物</button>
    </view>
  </view>

</view>
