page {
  background: #f4f7f5;
}

.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 60rpx;
  box-sizing: border-box;
}

/* 品牌区 */
.brand {
  text-align: center;
  margin-top: 140rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  line-height: 160rpx;
  font-size: 88rpx;
  text-align: center;
  border-radius: 50%;
  margin: 0 auto;
  background: linear-gradient(135deg, #16a34a, #22c55e);
  box-shadow: 0 16rpx 40rpx rgba(22, 163, 74, 0.3);
}

.app-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2937;
  margin-top: 32rpx;
}

.slogan {
  font-size: 26rpx;
  color: #9ca3af;
  margin-top: 12rpx;
}

/* 功能亮点 */
.features {
  margin-top: 80rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.feat {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.feat-ico {
  font-size: 36rpx;
  margin-right: 24rpx;
}

.feat-txt {
  font-size: 28rpx;
  color: #374151;
}

/* 登录区 */
.login-bottom {
  margin-top: auto;
  padding: 48rpx 0 60rpx;
}

.login-btn {
  background: linear-gradient(135deg, #16a34a, #22c55e);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 10rpx 0;
}

.login-btn[disabled] {
  opacity: 0.7;
  color: #ffffff;
}

.agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid #9ca3af;
  color: #ffffff;
  font-size: 22rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.checkbox.on {
  background: #16a34a;
  border-color: #16a34a;
}

.agree-text {
  font-size: 22rpx;
  color: #9ca3af;
}

.link {
  color: #16a34a;
}

.guest-tip {
  font-size: 22rpx;
  color: #f59e0b;
  text-align: center;
  margin-top: 20rpx;
  line-height: 1.6;
}

/* 深色模式 */
@media (prefers-color-scheme: dark) {
  page {
    background: #111827;
  }

  .app-name {
    color: #e5e7eb;
  }

  .features {
    background: #1f2937;
    box-shadow: none;
  }

  .feat-txt {
    color: #d1d5db;
  }

  .agree-text {
    color: #9ca3af;
  }
}
