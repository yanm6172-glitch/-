/* 周切换 */
.week-tabs {
  display: flex;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 4rpx;
}

.week-tab {
  padding: 6rpx 22rpx;
  font-size: 24rpx;
  color: #6b7280;
  border-radius: 10rpx;
}

.week-tab.active {
  background: #16a34a;
  color: #ffffff;
}

/* 周柱状图 */
.chart-wrap {
  display: flex;
  align-items: flex-end;
  height: 300rpx;
  padding: 16rpx 0 8rpx;
}

.bar-col {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bar {
  width: 56%;
  min-height: 6rpx;
  border-radius: 8rpx 8rpx 0 0;
}

.bar.ok {
  background: #16a34a;
}

.bar.over {
  background: #ef4444;
}

.bar.empty {
  background: #e5e7eb;
}

.bar-val {
  font-size: 20rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
}

.bar-label {
  font-size: 24rpx;
  font-weight: 600;
  margin-top: 8rpx;
  color: #374151;
}

.bar-date {
  font-size: 18rpx;
  color: #9ca3af;
}

/* 统计格 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.stat-item {
  width: 33.33%;
  text-align: center;
  padding: 16rpx 0;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #16a34a;
}

.stat-num.red {
  color: #ef4444;
}

.stat-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

/* 日历 */
.month-nav {
  display: flex;
  align-items: center;
}

.nav-btn {
  padding: 4rpx 18rpx;
  font-size: 36rpx;
  color: #16a34a;
}

.month-title {
  font-size: 26rpx;
  font-weight: 600;
  min-width: 150rpx;
  text-align: center;
}

.cal-head {
  display: flex;
  margin-top: 8rpx;
}

.cal-hd {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
  padding: 8rpx 0;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.2857%;
  display: flex;
  justify-content: center;
  padding: 6rpx 0;
}

.cal-day {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  color: #374151;
}

.cal-day.checked {
  background: #16a34a;
  color: #ffffff;
  font-weight: 600;
}

.cal-day.hasdata {
  background: #dcfce7;
  color: #15803d;
}

.cal-day.today {
  box-shadow: inset 0 0 0 2rpx #16a34a;
}

.cal-day.future {
  color: #d1d5db;
}

.cal-legend {
  display: flex;
  margin-top: 16rpx;
}

.lg {
  font-size: 22rpx;
  margin-right: 24rpx;
  color: #9ca3af;
}

.lg.checked {
  color: #16a34a;
}

.lg.hasdata {
  color: #15803d;
}

.lg.none {
  color: #9ca3af;
}

/* 导出按钮 */
.export-btn {
  width: 100%;
  border-radius: 16rpx;
  font-weight: 600;
}

/* 导出画布（移出屏幕外，不可见） */
.export-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 1250px;
}

/* 深色模式 */
@media (prefers-color-scheme: dark) {
  .week-tabs {
    background: #374151;
  }
  .week-tab {
    color: #9ca3af;
  }
  .bar.empty {
    background: #374151;
  }
  .bar-label {
    color: #e5e7eb;
  }
  .month-title {
    color: #e5e7eb;
  }
  .cal-day {
    color: #d1d5db;
  }
  .cal-day.hasdata {
    background: #14532d;
    color: #86efac;
  }
}
